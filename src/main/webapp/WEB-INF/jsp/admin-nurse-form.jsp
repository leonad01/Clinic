<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>เพิ่มพยาบาล | SmileCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/clinic.css?v=11" rel="stylesheet"></head>
<body class="bg-light"><%@ include file="includes/clinic-userbar.jspf" %><main class="container py-5"><div class="card shadow-sm p-4 mx-auto" style="max-width:680px"><h1 class="h3 mb-1">เพิ่มพยาบาล</h1><p class="text-secondary mb-4">กรอกข้อมูลบัญชีและข้อมูลติดต่อของพยาบาล</p><form action="${pageContext.request.contextPath}/admin/nurses" method="post"><label class="form-label" for="username">ชื่อผู้ใช้</label><input id="username" class="form-control mb-3" name="username" placeholder="ใช้ A-Z, 0-9, _ หรือ - จำนวน 4-30 ตัว" pattern="[A-Za-z0-9_-]{4,30}" maxlength="30" autocomplete="off" required><label class="form-label" for="password">รหัสผ่าน</label><input id="password" class="form-control mb-3" name="password" type="password" placeholder="อย่างน้อย 8 ตัวอักษร" minlength="8" autocomplete="new-password" required><label class="form-label" for="firstName">ชื่อ</label><input id="firstName" class="form-control mb-3" name="firstName" minlength="2" required><label class="form-label" for="lastName">นามสกุล</label><input id="lastName" class="form-control mb-3" name="lastName" minlength="2" required><label class="form-label" for="phone">เบอร์โทรศัพท์</label><input id="phone" class="form-control mb-3" name="phone" placeholder="เช่น 0812345678" inputmode="tel" pattern="0[0-9]{8,9}"><label class="form-label" for="email">อีเมล</label><input id="email" class="form-control mb-4" name="email" type="email"><button class="btn btn-primary" type="submit">บันทึกพยาบาล</button><a class="btn btn-link" href="${pageContext.request.contextPath}/admin/staff">กลับ</a></form></div></main></body></html>
