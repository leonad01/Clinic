<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>รายชื่อผู้ป่วย | SmileCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/clinic.css?v=12" rel="stylesheet"></head>
<body class="bg-light"><%@ include file="includes/clinic-userbar.jspf" %><main class="container py-5">
  <div class="d-flex justify-content-between align-items-center"><div><span class="text-primary fw-semibold">NURSE WORKSPACE</span><h1 class="h2 mt-1">รายชื่อผู้ป่วย</h1></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/nurse/appointments">รายการนัดหมาย</a></div>
  <div class="card shadow-sm mt-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ชื่อผู้ป่วย</th><th>เบอร์โทรศัพท์</th><th>เพศ</th><th>วันเกิด</th><th>ดำเนินการ</th></tr></thead><tbody><c:forEach items="${patients}" var="patient"><tr><td><a data-detail-modal href="${pageContext.request.contextPath}/nurse/patients/${patient.id}">${patient.firstName} ${patient.lastName}</a></td><td>${patient.phone}</td><td>${patient.gender}</td><td>${patient.dateOfBirth}</td><td><a class="btn btn-sm btn-outline-secondary" href="${pageContext.request.contextPath}/nurse/patients/${patient.id}/treatment-history">ประวัติการรักษา</a></td></tr></c:forEach><c:if test="${empty patients}"><tr><td colspan="5" class="text-center text-secondary py-4">ยังไม่มีข้อมูลผู้ป่วย</td></tr></c:if></tbody></table></div></div>
</main><%@ include file="includes/detail-modal.jspf" %></body></html>
