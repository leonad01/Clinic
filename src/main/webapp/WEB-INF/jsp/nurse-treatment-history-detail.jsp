<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>รายละเอียดการรักษา | SmileCare</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/css/clinic.css?v=13" rel="stylesheet"></head>
<body class="bg-light"><%@ include file="includes/clinic-userbar.jspf" %><main class="container py-5"><div class="card shadow-sm p-4 col-lg-8 mx-auto"><span class="text-primary fw-semibold">TREATMENT DETAIL</span><h1 class="h3 mt-2 mb-4">รายละเอียดการรักษา</h1><dl class="row mb-0"><dt class="col-sm-4">รหัสการจอง</dt><dd class="col-sm-8 fw-semibold">BK-<fmt:formatNumber value="${history.appointment.id}" pattern="000000" /></dd><dt class="col-sm-4">วันที่นัด</dt><dd class="col-sm-8">${history.appointment.appointmentDate}</dd><dt class="col-sm-4">เวลานัด</dt><dd class="col-sm-8">${history.appointment.appointmentTime} - ${history.appointment.appointmentEndTime}</dd><dt class="col-sm-4">บริการ</dt><dd class="col-sm-8">${history.appointment.service}</dd><dt class="col-sm-4">ทันตแพทย์</dt><dd class="col-sm-8">${history.dentist.firstName} ${history.dentist.lastName}</dd><dt class="col-sm-4">วันที่รักษา</dt><dd class="col-sm-8">${history.treatmentDate}</dd><dt class="col-sm-4">รายละเอียดการรักษา</dt><dd class="col-sm-8">${empty history.note ? '-' : history.note}</dd></dl></div></main></body></html>
